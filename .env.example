NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Python ingestion uses the authenticated publishing function, never browser keys for writes.
F1_INGEST_URL=
F1_INGEST_TOKEN=
# Next.js server only; never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
F1_CLIENT_HASH_SECRET=
F1_QUEUE_ENABLED=0
# Required when a separate domain rewrites requests to this app.
F1_PUBLIC_ORIGIN=https://edmundhong.com
# Separate Vercel Python worker deployment.
SUPABASE_URL=
F1_WORKER_TOKEN=
F1_WORKER_ENABLED=0
